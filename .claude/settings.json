{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -fr*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/skill-router.ps1\"", "timeout": 20}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/destructive-command-guard.ps1\"", "timeout": 20}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \".claude/hooks/notify.ps1\"", "timeout": 10, "async": true}]}]
  }
}
