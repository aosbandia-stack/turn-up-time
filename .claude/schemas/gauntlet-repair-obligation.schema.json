{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "contract_sha256", "finding_id", "original_finding", "original_failure", "original_build", "implementer", "owner_role", "affected_check_ids", "requirement_ids", "acceptance_sha256", "repair_authority", "recorded_at"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/text"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "finding_id": {"$ref": "#/$defs/text"},
    "original_finding": {"$ref": "#/$defs/ref"},
    "original_failure": {"$ref": "#/$defs/ref"},
    "original_build": {"$ref": "#/$defs/text"},
    "implementer": {"$ref": "#/$defs/text"},
    "owner_role": {"$ref": "#/$defs/text"},
    "affected_check_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "requirement_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "acceptance_sha256": {"$ref": "#/$defs/hash"},
    "repair_authority": {"$ref": "#/$defs/ref"},
    "recorded_at": {"type": "string", "format": "date-time"}
  }
}
