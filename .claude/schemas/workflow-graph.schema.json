{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn Up Time Executable Workflow Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transitions"],
  "properties": {
    "schema_version": {"const": 1},
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "event", "target", "verdict", "status", "loop_id", "max_traversals", "human_gate", "requires_new_evidence"],
        "properties": {
          "source": {"enum": ["INTAKE", "DISCOVERY", "EVIDENCE_REVIEW", "DEFINITION", "TICKETING", "SEAM_REVIEW", "BUILD", "INTEGRATION", "CLOSEOUT", "RELEASE", "WORKFLOW_CLOSEOUT", "DONE", "BLOCKED"]},
          "event": {"type": "string", "minLength": 1},
          "target": {"enum": ["INTAKE", "DISCOVERY", "EVIDENCE_REVIEW", "DEFINITION", "TICKETING", "SEAM_REVIEW", "BUILD", "INTEGRATION", "CLOSEOUT", "RELEASE", "WORKFLOW_CLOSEOUT", "DONE", "BLOCKED"]},
          "verdict": {"type": "string", "minLength": 1},
          "status": {"enum": ["ACTIVE", "AWAITING_HUMAN", "BLOCKED", "COMPLETE", "CANCELLED"]},
          "loop_id": {"type": ["string", "null"]},
          "max_traversals": {"type": ["integer", "null"], "minimum": 1},
          "human_gate": {"type": ["string", "null"]},
          "requires_new_evidence": {"type": "boolean"}
        }
      }
    }
  }
}
