{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "owner_by_requirement",
    "semantic_classes",
    "qualification_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "owner_by_requirement": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "semantic_classes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "qualification_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
