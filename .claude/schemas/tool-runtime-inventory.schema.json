{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained tool runtime inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "root",
    "files",
    "managed_paths",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runtime_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,95}$"
    },
    "root": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^[A-Za-z]:/[^\\\\]*$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\\\:]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "managed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\\\:]+$"
      }
    },
    "exclusions": {
      "enum": [
        [
          ".git"
        ],
        [
          ".git",
          "Lib/site-packages"
        ]
      ]
    }
  }
}
