{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "finding_id",
    "policy_sha256",
    "status",
    "action",
    "reason_codes",
    "candidate_owner",
    "duplicate_id",
    "acceptance",
    "evidence_refs",
    "provider",
    "model",
    "qualification_status",
    "fallback_status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "finding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "RECOMMENDATION",
        "PENDING",
        "BLOCKED"
      ]
    },
    "action": {
      "enum": [
        "ROUTE_AUTHORIZED_REPAIR",
        "REQUEST_EVIDENCE",
        "LINK_DUPLICATE",
        "REJECT_WITH_EVIDENCE",
        "REFER_ARCHITECT",
        "REFER_OWNER"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "candidate_owner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "duplicate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "qualification_status": {
      "enum": [
        "NOT_APPLICABLE",
        "QUALIFIED",
        "UNQUALIFIED"
      ]
    },
    "fallback_status": {
      "enum": [
        "NONE",
        "PENDING",
        "BLOCKED"
      ]
    }
  }
}
