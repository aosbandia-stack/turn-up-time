{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn Up Time Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "bundled", "stages", "authority", "consumes", "produces", "conflicts", "eval", "uninstall"],
        "properties": {
          "provider": {"type": "string", "minLength": 1},
          "bundled": {"type": "boolean"},
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["ANY", "BUILD", "INTEGRATION", "CLOSEOUT", "RELEASE"]}
          },
          "mode": {"type": "string"},
          "authority": {"enum": ["control", "production", "assurance", "reference"]},
          "consumes": {"type": "array", "items": {"type": "string"}},
          "produces": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "eval": {"type": "string", "minLength": 1},
          "uninstall": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
