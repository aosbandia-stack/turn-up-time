{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "locked_by",
    "requirements",
    "checks",
    "mandatory_finding_ids",
    "repair_cases",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "locked_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_ids",
          "journey",
          "state",
          "surface",
          "required",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "journey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "surface": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "required": {
            "type": "boolean"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "mandatory_finding_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "repair_cases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "original_failure",
          "original_build",
          "implementer",
          "affected_check_ids",
          "acceptance_sha256"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "original_failure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "original_build": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "implementer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "affected_check_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "acceptance_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "baseline_used",
        "baseline_event_ids"
      ],
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "baseline_used": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "baseline_event_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    }
  }
}
