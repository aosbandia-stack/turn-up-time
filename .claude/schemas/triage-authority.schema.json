{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "finding_ids",
    "owner_roles",
    "requirement_ids",
    "status",
    "approval_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "owner_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "status": {
      "const": "APPROVED"
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    }
  }
}
