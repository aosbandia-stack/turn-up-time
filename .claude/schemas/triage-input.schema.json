{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "finding",
    "policy",
    "evidence_refs",
    "requirement_ids",
    "owner_candidates",
    "duplicate_candidates",
    "prior_attempts",
    "repair_authority",
    "provider"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "finding": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Validated Product Finding",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "project_id",
        "finding_id",
        "build_identity",
        "requirement_ids",
        "journey_step",
        "expected",
        "observed",
        "impact",
        "recovery",
        "evidence",
        "severity",
        "type",
        "status",
        "owner_role",
        "acceptance_criteria",
        "verification_status"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "project_id": {
          "type": "string"
        },
        "finding_id": {
          "type": "string"
        },
        "build_identity": {
          "type": "string"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journey_step": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "impact": {
          "type": "string"
        },
        "recovery": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "severity": {
          "enum": [
            "S0",
            "S1",
            "S2",
            "S3",
            "S4"
          ]
        },
        "type": {
          "enum": [
            "defect",
            "friction",
            "content",
            "accessibility",
            "craft",
            "performance",
            "security",
            "environment",
            "business-question",
            "feature-proposal"
          ]
        },
        "status": {
          "enum": [
            "RAW",
            "VALIDATED",
            "REJECTED",
            "AUTHORIZED",
            "IMPLEMENTED",
            "VERIFIED",
            "REOPENED",
            "BLOCKED",
            "DEFERRED",
            "SUPERSEDED"
          ]
        },
        "owner_role": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "type": "string"
        },
        "verification_status": {
          "enum": [
            "NOT_RUN",
            "VERIFIED",
            "REOPENED",
            "PARTIALLY_VERIFIED",
            "BLOCKED_BY_ENVIRONMENT",
            "BLOCKED_BY_DECISION",
            "SUPERSEDED",
            "DEFERRED_WITH_OWNER"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "owner_candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "duplicate_candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "prior_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "repair_authority": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "fallback",
        "model",
        "qualification",
        "permit_egress",
        "permit_cost",
        "permitted_fields",
        "timeout_seconds"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic",
            "jev",
            "reasoning"
          ]
        },
        "fallback": {
          "enum": [
            "BLOCKED",
            "reasoning"
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "permit_egress": {
          "type": "boolean"
        },
        "permit_cost": {
          "type": "boolean"
        },
        "permitted_fields": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  }
}
