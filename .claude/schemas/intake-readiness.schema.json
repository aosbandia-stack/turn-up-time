{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake Readiness Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "status", "primary_user", "primary_job", "desired_outcome", "product_boundary", "permitted_actions", "prohibited_actions", "critical_constraints", "non_goals", "human_owned_decisions", "deferred_risks"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "READY", "READY_WITH_DEFERRED_RISK", "BLOCKED_BY_PRODUCT_DECISION"]},
    "primary_user": {"type": "string"},
    "primary_job": {"type": "string"},
    "desired_outcome": {"type": "string"},
    "product_boundary": {"type": "string"},
    "permitted_actions": {"type": "array", "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "items": {"type": "string"}},
    "critical_constraints": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "human_owned_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "status"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "status": {"enum": ["OPEN", "RESOLVED", "DEFERRED"]},
          "resolution": {"type": ["string", "null"]},
          "decided_by": {"type": ["string", "null"]},
          "decided_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "deferred_risks": {"type": "array", "items": {"type": "string"}}
  }
}
