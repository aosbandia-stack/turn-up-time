{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "production-audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "status",
    "reviewer",
    "checked_at",
    "evidence_refs",
    "blockers",
    "accepted_risks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "build_identity": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SHIP",
        "SHIP_WITH_ACCEPTED_RISK",
        "BLOCK"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accepted_risks": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
