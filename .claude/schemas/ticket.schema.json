{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticket_id",
    "requirement_ids",
    "user_outcome",
    "scope",
    "non_scope",
    "inputs",
    "outputs",
    "dependencies",
    "shared_contracts",
    "acceptance_checks",
    "required_capabilities",
    "risk_class",
    "rollback",
    "owner_role"
  ],
  "properties": {
    "ticket_id": {"type": "string"},
    "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "user_outcome": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "non_scope": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array"},
    "outputs": {"type": "array"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "shared_contracts": {"type": "array"},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "check", "expected"], "properties": {"id": {"type": "string"}, "check": {"type": "string"}, "expected": {"type": "string"}, "evidence": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "rollback": {"type": "string"},
    "owner_role": {"type": "string"}
  }
}
