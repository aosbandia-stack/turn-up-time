{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executable Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ticket_id", "status", "requirement_ids", "evidence_refs", "user_outcome", "scope", "non_scope", "files_or_surfaces", "inputs", "outputs", "dependencies", "shared_contracts", "acceptance_checks", "required_capabilities", "risk_class", "rollback", "owner_role", "human_gates"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "ticket_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "APPROVED", "IN_PROGRESS", "TICKET_EVIDENCE_GREEN", "BLOCKED", "SUPERSEDED"]},
    "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "user_outcome": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files_or_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "array", "minItems": 1},
    "outputs": {"type": "array", "minItems": 1},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "shared_contracts": {"type": "array"},
    "acceptance_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "expected", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "evidence": {"type": ["string", "null"]}
        }
      }
    },
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "rollback": {"type": "string", "minLength": 1},
    "owner_role": {"const": "implementation-engineer"},
    "human_gates": {"type": "array", "items": {"type": "string"}}
  }
}
