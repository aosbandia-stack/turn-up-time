{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definition of Good",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "version", "status", "requirements", "human_gates", "non_goals", "source_artifact_hashes", "approved_by", "approved_at"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["DRAFT", "AWAITING_HUMAN", "APPROVED", "SUPERSEDED"]},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "priority", "evidence_refs", "acceptance_condition", "verification_method", "owner_surface", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "priority": {"enum": ["MUST", "SHOULD", "OPTIONAL"]},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "acceptance_condition": {"type": "string", "minLength": 1},
          "verification_method": {"type": "string", "minLength": 1},
          "owner_surface": {"enum": ["product", "frontend", "backend", "security", "integration", "operations", "human"]},
          "status": {"enum": ["ACTIVE", "DEFERRED", "NOT_APPLICABLE"]}
        }
      }
    },
    "human_gates": {"type": "array", "items": {"type": "string"}},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "source_artifact_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}},
    "approved_by": {"type": ["string", "null"]},
    "approved_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "APPROVED"}}},
      "then": {
        "properties": {
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  ]
}
