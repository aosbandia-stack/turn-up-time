{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Definition of Good",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "status",
    "requirements",
    "critical_journeys",
    "non_goals",
    "human_gates",
    "approved_by",
    "approved_at",
    "ui",
    "non_ui_proof",
    "deployment",
    "maintainability",
    "execution_environment"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "SUPERSEDED"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "priority",
          "evidence_refs",
          "acceptance",
          "owner_surface",
          "ticket_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "MUST",
              "SHOULD",
              "OPTIONAL"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "check",
              "expected"
            ],
            "properties": {
              "type": {
                "enum": [
                  "deterministic",
                  "experiential",
                  "human_gate"
                ]
              },
              "check": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              }
            }
          },
          "owner_surface": {
            "type": "string"
          },
          "ticket_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "critical_journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "persona",
          "start_state",
          "steps",
          "success",
          "failure_and_recovery",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "persona": {
            "type": "string"
          },
          "start_state": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "success": {
            "type": "string"
          },
          "failure_and_recovery": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        }
      }
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reason",
        "design_reference",
        "component_owner",
        "shared_components",
        "route_states",
        "viewports",
        "keyboard_expectations",
        "first_slice_journey_id"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "design_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "component_owner": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "shared_components": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "route_states": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "states"
            ],
            "properties": {
              "route": {
                "type": "string",
                "minLength": 1
              },
              "states": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "viewports": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "keyboard_expectations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "first_slice_journey_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "surfaces": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "platform",
              "purpose",
              "stack",
              "routes",
              "flags",
              "change_scope",
              "research_disposition",
              "research",
              "verification_capabilities"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "web",
                  "native"
                ]
              },
              "purpose": {
                "enum": [
                  "operate",
                  "persuade",
                  "read",
                  "experience"
                ]
              },
              "stack": {
                "type": "string",
                "minLength": 1
              },
              "routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "flags": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "change_scope": {
                "enum": [
                  "NEW",
                  "REDESIGN",
                  "REFINEMENT"
                ]
              },
              "research_disposition": {
                "enum": [
                  "COMPARABLES",
                  "REUSE_GUIDE"
                ]
              },
              "research": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "basis",
                    "observation",
                    "disposition",
                    "rationale",
                    "guide_ref",
                    "evidence_refs"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "basis": {
                      "enum": [
                        "OBSERVED",
                        "SUPPLIED"
                      ]
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "disposition": {
                      "enum": [
                        "ADOPT",
                        "ADAPT",
                        "REJECT"
                      ]
                    },
                    "rationale": {
                      "type": "string",
                      "minLength": 1
                    },
                    "guide_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "sha256"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      }
                    }
                  }
                },
                "maxItems": 3
              },
              "verification_capabilities": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "design_loop": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rubric_version",
                "rubric_sha256",
                "guide_sha256",
                "locked_at",
                "criteria",
                "hard_gates",
                "max_rounds",
                "max_elapsed_seconds",
                "max_stagnant_rounds",
                "cost_ceiling"
              ],
              "properties": {
                "rubric_version": {
                  "type": "string",
                  "minLength": 1
                },
                "rubric_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "guide_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locked_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "critical",
                      "minimum",
                      "anchors"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "critical": {
                        "type": "boolean"
                      },
                      "minimum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4
                      },
                      "anchors": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "0",
                          "1",
                          "2",
                          "3",
                          "4"
                        ],
                        "properties": {
                          "0": {
                            "type": "string",
                            "minLength": 1
                          },
                          "1": {
                            "type": "string",
                            "minLength": 1
                          },
                          "2": {
                            "type": "string",
                            "minLength": 1
                          },
                          "3": {
                            "type": "string",
                            "minLength": 1
                          },
                          "4": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                },
                "hard_gates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "max_rounds": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_elapsed_seconds": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max_stagnant_rounds": {
                  "type": "integer",
                  "minimum": 1
                },
                "cost_ceiling": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "amount",
                        "unit"
                      ],
                      "properties": {
                        "amount": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "non_ui_proof": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target",
        "environment"
      ],
      "properties": {
        "scope": {
          "enum": [
            "CANDIDATE_ONLY",
            "DEPLOYED"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "environment": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "maintainability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "layout_ref",
        "entrypoints",
        "generated_paths",
        "temporary_paths"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "layout_ref": {
          "type": "string",
          "minLength": 1
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated_paths": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temporary_paths": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "execution_environment": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ui": {
            "properties": {
              "applicable": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "critical_journeys": {
            "minItems": 1
          },
          "ui": {
            "properties": {
              "design_reference": {
                "type": "string",
                "minLength": 1
              },
              "component_owner": {
                "type": "string",
                "minLength": 1
              },
              "shared_components": {
                "minItems": 1
              },
              "route_states": {
                "minItems": 1
              },
              "viewports": {
                "minItems": 2
              },
              "keyboard_expectations": {
                "minItems": 1
              },
              "first_slice_journey_id": {
                "type": "string",
                "minLength": 1
              },
              "surfaces": {
                "minItems": 1
              }
            },
            "required": [
              "surfaces"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "non_ui_proof": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": {
              "scope": {
                "const": "DEPLOYED"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deployment": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
