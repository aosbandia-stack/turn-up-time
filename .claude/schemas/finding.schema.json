{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "journey_step",
    "expected",
    "observed",
    "impact",
    "evidence",
    "severity",
    "status",
    "owner_role",
    "acceptance_criteria"
  ],
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "journey_step": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "observed": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "severity": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4"
      ]
    },
    "status": {
      "enum": [
        "RAW",
        "VALIDATED",
        "REJECTED",
        "IMPLEMENTED",
        "VERIFIED",
        "REOPENED",
        "BLOCKED"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "string"
    }
  }
}
