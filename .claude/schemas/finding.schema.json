{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "requirement_ids", "finding_type", "journey_step", "expected", "observed", "impact", "recovery", "evidence", "severity", "status", "owner_role", "acceptance_criteria"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 2},
    "finding_id": {"type": "string", "minLength": 1},
    "requirement_ids": {"type": "array", "items": {"type": "string"}},
    "finding_type": {"enum": ["defect", "friction", "content", "accessibility", "ui-craft", "performance", "security-privacy", "business-rule-question", "feature-proposal", "environment"]},
    "journey_step": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "observed": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "recovery": {"type": ["string", "null"]},
    "evidence": {"type": "array", "minItems": 1},
    "severity": {"enum": ["S0", "S1", "S2", "S3", "S4"]},
    "status": {"enum": ["RAW", "VALIDATED", "REJECTED", "IMPLEMENTED", "VERIFIED", "REOPENED", "BLOCKED", "DEFERRED", "SUPERSEDED"]},
    "owner_role": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "string", "minLength": 1}
  }
}
