{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn Up Time Graph Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "project_id", "thread_id", "from_stage", "to_stage", "trigger", "verdict", "loop_id", "iteration", "approved_by", "evidence_delta", "receipt_refs", "ledger_sha256_before", "ledger_sha256_after", "occurred_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"const": "EDGE_TRAVERSED"},
    "project_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "from_stage": {"type": "string"},
    "to_stage": {"type": "string"},
    "trigger": {"type": "string"},
    "verdict": {"type": "string"},
    "loop_id": {"type": ["string", "null"]},
    "iteration": {"type": ["integer", "null"], "minimum": 1},
    "approved_by": {"type": ["string", "null"]},
    "evidence_delta": {"type": "array", "items": {"type": "string"}},
    "receipt_refs": {"type": "array", "items": {"type": "string"}},
    "ledger_sha256_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ledger_sha256_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
