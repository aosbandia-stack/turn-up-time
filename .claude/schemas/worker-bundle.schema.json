{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "project_id",
    "task_id",
    "build_identity",
    "stage",
    "role",
    "registry_sha256",
    "lock_sha256",
    "selected_capabilities",
    "providers",
    "required_outputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "stage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "selected_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "capabilities",
          "provider_kind",
          "authority",
          "source_ref",
          "entrypoint",
          "assets",
          "instructions_utf8",
          "instructions_sha256",
          "readiness_status",
          "readiness_refs",
          "readiness_valid_until",
          "readiness_environment",
          "required_outputs"
        ],
        "allOf": [
          {
            "if": {"properties": {"provider_kind": {"const": "external"}}},
            "then": {
              "properties": {
                "readiness_valid_until": {"type": "string", "format": "date-time"},
                "readiness_environment": {"type": "string", "minLength": 1, "maxLength": 256}
              }
            },
            "else": {
              "properties": {
                "readiness_valid_until": {"type": "null"},
                "readiness_environment": {"type": "null"}
              }
            }
          }
        ],
        "properties": {
          "readiness_valid_until": {"type": ["string", "null"], "maxLength": 64},
          "readiness_environment": {"type": ["string", "null"], "maxLength": 256},
          "required_outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "provider_kind": {
            "enum": [
              "instruction-only",
              "external"
            ]
          },
          "authority": {
            "enum": [
              "control",
              "production",
              "assurance",
              "reference"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "instructions_utf8": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000000
          },
          "instructions_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "readiness_status": {
            "const": "READY"
          },
          "readiness_refs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
