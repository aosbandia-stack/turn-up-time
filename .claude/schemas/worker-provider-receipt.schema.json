{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_id",
    "project_id",
    "task_id",
    "build_identity",
    "dispatch_id",
    "manifest_sha256",
    "provider",
    "capability_ids",
    "instruction_sha256",
    "invocation_refs",
    "output_refs",
    "consumed_by",
    "status",
    "verification_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "build_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "capability_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "instruction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "invocation_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "output_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "consumed_by": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "status": {
      "enum": [
        "APPLIED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "verification_ref": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[!-~]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
