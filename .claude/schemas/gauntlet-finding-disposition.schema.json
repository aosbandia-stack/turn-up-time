{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "build_identity", "contract_sha256", "finding_id", "original_finding", "action", "canonical_finding_id", "triage_dispatch_id", "affected_check_ids", "evidence_refs", "rationale", "checked_at", "supersedes"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 8192},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}}
  },
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"$ref": "#/$defs/text"},
    "build_identity": {"$ref": "#/$defs/text"},
    "contract_sha256": {"$ref": "#/$defs/hash"},
    "finding_id": {"$ref": "#/$defs/text"},
    "original_finding": {"$ref": "#/$defs/ref"},
    "supersedes": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "action": {"enum": ["REJECT_WITH_EVIDENCE", "LINK_DUPLICATE"]},
    "canonical_finding_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 8192},
    "triage_dispatch_id": {"$ref": "#/$defs/text"},
    "affected_check_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/ref"}},
    "rationale": {"type": "string", "minLength": 20, "maxLength": 8192, "pattern": "\\S"},
    "checked_at": {"type": "string", "format": "date-time"}
  }
}
