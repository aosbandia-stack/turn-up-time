{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "check_id",
    "status",
    "checked_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "build_identity": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "target",
        "environment"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cleanup_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "decision"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "REMOVE",
            "CONSOLIDATE"
          ]
        }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "authority_required",
        "authority_status",
        "by",
        "at"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PROCEED",
            "BLOCK"
          ]
        },
        "authority_required": {
          "type": "boolean"
        },
        "authority_status": {
          "enum": [
            "APPROVED",
            "NOT_REQUIRED",
            "PENDING",
            "REJECTED"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "design_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubric_sha256",
        "guide_sha256",
        "evaluator_role",
        "evaluator_id",
        "started_at",
        "criteria",
        "hard_gates",
        "cumulative_cost",
        "cost_unit",
        "cost_evidence_refs"
      ],
      "properties": {
        "rubric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "guide_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_role": {
          "enum": [
            "assurance",
            "production",
            "control"
          ]
        },
        "evaluator_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidence_refs",
              "score"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "score": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        },
        "hard_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "evidence_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "cumulative_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cost_evidence_refs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
