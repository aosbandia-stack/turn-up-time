{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verification-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "build_identity",
    "check_id",
    "status",
    "checked_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "build_identity": {
      "type": "string",
      "minLength": 1
    },
    "check_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "target",
        "environment"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
