{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traceability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "requirements",
    "journeys"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "design_ref",
          "ticket_ids",
          "human_gate",
          "owner",
          "acceptance_checks"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "design_ref": {
            "type": "string",
            "minLength": 1
          },
          "ticket_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "human_gate": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_checks": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ticket_id",
                "check_id"
              ],
              "properties": {
                "ticket_id": {
                  "type": "string",
                  "minLength": 1
                },
                "check_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "journeys": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journey_id",
          "design_ref",
          "ticket_ids",
          "owner",
          "verification_owner",
          "evidence_refs"
        ],
        "properties": {
          "journey_id": {
            "type": "string",
            "minLength": 1
          },
          "design_ref": {
            "type": "string",
            "minLength": 1
          },
          "ticket_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "verification_owner": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
