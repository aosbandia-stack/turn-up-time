{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "model",
    "policy_sha256",
    "decision_class",
    "status",
    "evaluated_by",
    "evidence_refs",
    "minimum_probability"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider": {
      "const": "typesafe-ai"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_class": {
      "const": "owner-routing"
    },
    "status": {
      "const": "QUALIFIED"
    },
    "evaluated_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "minimum_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
