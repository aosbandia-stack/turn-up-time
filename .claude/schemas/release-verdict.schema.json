{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "build_identity", "production_audit", "final_judge", "status", "accepted_risks", "blockers", "evidence_refs", "guard_receipt_ref", "human_approval", "decided_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string"},
    "build_identity": {"type": "string", "minLength": 1},
    "production_audit": {"enum": ["SHIP", "SHIP_WITH_ACCEPTED_RISK", "BLOCK"]},
    "final_judge": {"enum": ["GREEN", "RED", "BLOCKED"]},
    "status": {"enum": ["SHIP", "SHIP_WITH_ACCEPTED_RISK", "BLOCK"]},
    "accepted_risks": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "guard_receipt_ref": {"type": ["string", "null"]},
    "human_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "by", "at"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "REJECTED"]},
        "by": {"type": ["string", "null"]},
        "at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "decided_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["SHIP", "SHIP_WITH_ACCEPTED_RISK"]}}},
      "then": {
        "properties": {
          "production_audit": {"enum": ["SHIP", "SHIP_WITH_ACCEPTED_RISK"]},
          "final_judge": {"const": "GREEN"},
          "blockers": {"maxItems": 0}
        }
      }
    }
  ]
}
