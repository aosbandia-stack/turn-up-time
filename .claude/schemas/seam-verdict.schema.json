{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Integration Seam Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "phase", "status", "ticket_refs", "findings", "checked_at", "reviewer"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string"},
    "phase": {"enum": ["PRE_BUILD", "POST_BUILD"]},
    "status": {"enum": ["SEAMS_SOUND", "SEAMS_BLOCKED"]},
    "ticket_refs": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "description", "owner_ticket", "blocking", "acceptance"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"enum": ["S0", "S1", "S2", "S3"]},
          "description": {"type": "string"},
          "owner_ticket": {"type": ["string", "null"]},
          "blocking": {"type": "boolean"},
          "acceptance": {"type": "string"}
        }
      }
    },
    "checked_at": {"type": "string", "format": "date-time"},
    "reviewer": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SEAMS_SOUND"}}},
      "then": {"properties": {"findings": {"not": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}}}
    }
  ]
}
