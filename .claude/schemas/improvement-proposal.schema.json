{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Improvement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "improvement_id", "source_project_ids", "observed_failure", "evidence", "frequency", "workflow_stage", "root_cause", "existing_control", "proposed_change", "scope", "expected_effect", "measurement", "seeded_failure_eval", "cost", "new_risks", "rollback", "warrant", "review_date", "human_decision", "status"],
  "properties": {
    "schema_version": {"const": 2},
    "improvement_id": {"type": "string"},
    "source_project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "observed_failure": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "frequency": {"type": "string"},
    "workflow_stage": {"enum": ["ROUTING", "INTAKE", "DISCOVERY", "EVIDENCE_REVIEW", "DEFINITION", "TICKETING", "SEAM_REVIEW", "BUILD", "INTEGRATION", "CLOSEOUT", "RELEASE", "CONTINUITY"]},
    "root_cause": {"type": "string"},
    "existing_control": {"type": ["string", "null"]},
    "proposed_change": {"type": "string"},
    "scope": {"enum": ["project", "global"]},
    "expected_effect": {"type": "string"},
    "measurement": {"type": "string"},
    "seeded_failure_eval": {"type": "string"},
    "cost": {"type": "string"},
    "new_risks": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "string"},
    "warrant": {"enum": ["incident", "prediction"]},
    "review_date": {"type": "string", "format": "date"},
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "by", "at", "notes"],
      "properties": {
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "DEFERRED", "PROJECT_PILOT"]},
        "by": {"type": ["string", "null"]},
        "at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["OBSERVED", "VALIDATED", "RESEARCHED", "PROPOSED", "APPROVED", "REJECTED", "DEFERRED", "IMPLEMENTED", "EVAL_GREEN", "EVAL_RED", "RETIRED"]}
  }
}
