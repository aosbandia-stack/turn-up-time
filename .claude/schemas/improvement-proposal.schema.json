{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Improvement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "improvement_id",
    "observed_failure",
    "evidence",
    "frequency",
    "workflow_stage",
    "root_cause",
    "existing_control",
    "proposed_change",
    "scope",
    "expected_effect",
    "measurement",
    "seeded_failure_eval",
    "cost",
    "new_risks",
    "rollback",
    "warrant",
    "review_date",
    "status"
  ],
  "properties": {
    "improvement_id": {
      "type": "string"
    },
    "observed_failure": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "frequency": {
      "type": "string"
    },
    "workflow_stage": {
      "type": "string"
    },
    "root_cause": {
      "type": "string"
    },
    "existing_control": {
      "type": "string"
    },
    "proposed_change": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "project",
        "global"
      ]
    },
    "expected_effect": {
      "type": "string"
    },
    "measurement": {
      "type": "string"
    },
    "seeded_failure_eval": {
      "type": "string"
    },
    "cost": {
      "type": "string"
    },
    "new_risks": {
      "type": "array"
    },
    "rollback": {
      "type": "string"
    },
    "warrant": {
      "enum": [
        "incident",
        "prediction"
      ]
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "OBSERVED",
        "VALIDATED",
        "RESEARCHED",
        "PROPOSED",
        "APPROVED",
        "REJECTED",
        "DEFERRED",
        "IMPLEMENTED",
        "EVAL_GREEN",
        "EVAL_RED",
        "RETIRED"
      ]
    }
  }
}
